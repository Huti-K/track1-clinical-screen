# Copy to .env. By default the app signs in with your ChatGPT account (openai-codex) on its
# sign-in page and needs nothing here.
# MODEL=openai-codex/gpt-6.1-terra
# SCREEN_THINKING=low

# priority is ChatGPT's fast mode on every OpenAI request, the contradiction scan and fact index
# included. It uses the plan's limits about twice as fast; default sends the normal tier.
# SERVICE_TIER=priority

# Builds the fact index and finds contradictions once per store, in the background. No screen or
# answer waits for them: until the index is ready, a screen reads the whole record instead.
# BACKGROUND_MODEL=openai-codex/gpt-6.1-terra
# SCAN_THINKING=high
# The index runs in parallel parts of at most 40 passages, each reviewed as soon as it is built.
# INDEX_THINKING=low
# Background runs at once across all patients; more is faster until the provider's rate limit.
# BACKGROUND_CONCURRENCY=16

# index: screens pick facts from the index, with the whole record beside it (fastest).
# context: the whole record only. tools: search tools only. hybrid: record and search tools.
# RETRIEVAL=index

# Or any pi-ai provider with its API key, for example Claude Haiku through OpenRouter:
# MODEL=openrouter/~anthropic/claude-haiku-latest
# OPENROUTER_API_KEY=

# PATIENT_DIR=data/patient-0000-0001
# STORE_PATH=.data/agent.sqlite
# PORT=3001
